 "yenSozlesmesi": {
  "gruplar": [
   "yen_kivrik_L",
   "yen_kivrik_R"
  ],
  "s": "çalarken 1, değilken 0; geçiş doğrusal (0.5 de ölçüldü)",
  "agirlik": "değişmez: kol ağzı köşeleri Hand (0.13-0.18) + LowerArm + J_Sec_*_TipSleeve (0.36-0.61) karışımı",
  "TipSleeve": "s = yen_kivrik_<taraf>; J_Sec_<taraf>_TipSleeve dünya matrisi = slerp(doğal, kilit, s) (dönüş slerp, konum lerp); kilit = W(J_Bip_<taraf>_LowerArm) · B(LowerArm)⁻¹ · B(TipSleeve) (B: dünya dinlenme matrisi; yani ön kola dinlenmedeki göreli yerinde kilitli, bilek dönüşü iptal). Eşdeğeri: kilit = W(LowerArm) · L0(Hand) · L0(TipSleeve) (L0: dinlenme yerel matrisi); TipSleeve yerel = W(Hand)⁻¹ · istenen dünya matrisi.",
  "LowerSleeve": "J_Sec_<taraf>_LowerSleeve ve TipSleeve ikincil salınımı (yerçekimi, gitar itmesi) × (1 − s); s = 1 iken ikisi de dinlenme yerinde",
  "kalan": "kilitliyken kol ağzında yalnız Hand ağırlığı (≤ 0.18) bilek dönüşünü taşır; ölçüm pozlarında bu payla ölçüldü",
